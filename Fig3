###############################################
# BOTTOM PANEL
###############################################
window.size <- 50
step.size <- 20

sliding.df <- meanResiduals.df %>%
  group_by(rna) %>%
  arrange(pos) %>%
  group_modify(~{
    
    df <- .x
    
    max.pos <- max(df$pos, na.rm = TRUE)
    
    windows <- tibble(
      window.start = seq(1, max.pos - window.size, by = step.size)
    ) %>%
      mutate(
        window.end = window.start + window.size - 1
      )
    
    windows %>%
      rowwise() %>%
      mutate(
        mean.window.residual = mean(
          df$meanResidual[
            df$pos >= window.start &
              df$pos <= window.end
          ],
          na.rm = TRUE
        )
      ) %>%
      ungroup()
    
  }) %>%
  ungroup()

p.bottom <- sliding.df %>%
  ggplot(aes(x = window.start,
             y = mean.window.residual)) +
  
  ###########################################
  # Coding regions
  ###########################################
  geom_rect(data = orv.proteins %>%
              filter(protein != "putative"),
            aes(xmin = start,
                xmax = end,
                ymin = -Inf,
                ymax = Inf,
                fill = protein),
            alpha = 0.05,
            inherit.aes = FALSE) +
    

  # Palmprint motifs
  ###########################################
  geom_rect(data = palmprint.orv,
            aes(xmin = nt.start,
