# d.f.
merged.df %>% nrow() -2

###############################################
# MAGNITUDE ONLY
###############################################

cor.test(
  abs(merged.df$mean.window.residual),
  abs(merged.df$mfe.bias),
  method = "spearman"
)


###############################################
# PERMUTATION TEST
###############################################

obs <- cor(
  abs(merged.df$mean.window.residual),
  abs(merged.df$mfe.bias),
  method = "spearman"
)

perm <- replicate(5000, {
  
  cor(
    sample(abs(merged.df$mean.window.residual)),
    abs(merged.df$mfe.bias),
    method = "spearman"
  )
  
})

mean(abs(perm) >= abs(obs))


###############################################
# HOTSPOTS
###############################################

threshold <- quantile(
  abs(merged.df$mean.window.residual),
  0.95,
  na.rm = TRUE
)

merged.df <- merged.df %>%
  mutate(
    hotspot = abs(mean.window.residual) >= threshold
  )

###############################################
# DO HOTSPOTS HAVE HIGHER STRUCTURE BIAS?
###############################################

wilcox.test(
  abs(mfe.bias) ~ hotspot,
  data = merged.df
)

###############################################
# LINEAR MODEL
###############################################

lm.bias <- lm(
  abs(mean.window.residual) ~ abs(mfe.bias),
  data = merged.df
)

summary(lm.bias)


