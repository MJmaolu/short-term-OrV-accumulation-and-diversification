# Manteniendo todos los puntos
meanResiduals.df <- df_complete.normH_wider %>%
  filter(hpi > 2) %>%
  group_by(rna, pos, hpi) %>%
  summarise(meanResidual = mean(Sn.residuals, na.rm = TRUE),
            .groups = "drop")

###############################################
# SEGMENT-SPECIFIC THRESHOLDS
###############################################

meanSnResiduals.quantiles.new <- meanResiduals.df %>%
  group_by(rna) %>%
  summarise(
    Q1  = quantile(meanResidual, 0.25, na.rm = TRUE),
    Q3  = quantile(meanResidual, 0.75, na.rm = TRUE),
    P5  = quantile(meanResidual, 0.05, na.rm = TRUE),
    P95 = quantile(meanResidual, 0.95, na.rm = TRUE),
    P1  = quantile(meanResidual, 0.01, na.rm = TRUE),
    P99 = quantile(meanResidual, 0.99, na.rm = TRUE),
    .groups = "drop"
  )

###############################################
# CLASSIFY POSITIONS
###############################################

meanResiduals.classified <- meanResiduals.df %>%
  left_join(meanSnResiduals.quantiles.new,
            by = "rna") %>%
  mutate(class = case_when(
    
    meanResidual < P1 |
      meanResidual > P99 ~ "extreme",
    
    meanResidual < P5 |
      meanResidual > P95 ~ "strong",
    
    meanResidual < Q1 |
      meanResidual > Q3 ~ "moderate",
    
    TRUE ~ "central"
  ))

